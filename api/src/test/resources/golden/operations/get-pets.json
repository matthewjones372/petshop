{
  "paths": {
    "/pets": {
      "get": {
        "summary": "Every pet in the shop",
        "operationId": "getPets",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PetDto"
                  }
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "enum": [
              "Cat",
              "Dog",
              "Parrot",
              "Tortoise"
            ]
          },
          "adopted": {
            "type": "boolean"
          }
        },
        "required": [
          "adopted",
          "id",
          "name",
          "species"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}

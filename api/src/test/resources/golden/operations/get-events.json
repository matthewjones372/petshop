{
  "paths": {
    "/events": {
      "get": {
        "summary": "Arrivals, adoptions and returns, as the shop's events reach it",
        "operationId": "getEvents",
        "tags": [
          "shop"
        ],
        "responses": {
          "200": {
            "description": "A server-sent event stream.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ShopEventDto"
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "enum": [
              "Cat",
              "Dog",
              "Parrot",
              "Tortoise"
            ]
          },
          "adopted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "species",
          "adopted"
        ]
      },
      "ShopEventDto": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Arrived",
              "Adopted"
            ]
          },
          "pet": {
            "$ref": "#/components/schemas/PetDto"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "seq",
          "kind",
          "pet"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}

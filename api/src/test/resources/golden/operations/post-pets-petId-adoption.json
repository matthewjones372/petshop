{
  "paths": {
    "/pets/{petId}/adoption": {
      "post": {
        "summary": "Take a pet home",
        "operationId": "postPetsByPetIdAdoption",
        "tags": [
          "pets"
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "The pet's id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetDto"
                }
              }
            }
          },
          "202": {
            "description": "Recorded; the chip registry has yet to confirm it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetDto"
                }
              }
            }
          },
          "404": {
            "description": "No pet with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoSuchPet"
                }
              }
            }
          },
          "409": {
            "description": "One of:\n\n- `already_adopted`: That pet has already been adopted\n- `being_adopted`: That pet is being adopted; it may come back to the shelf",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AlreadyAdopted"
                    },
                    {
                      "$ref": "#/components/schemas/BeingAdopted"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "already_adopted": "#/components/schemas/AlreadyAdopted",
                      "being_adopted": "#/components/schemas/BeingAdopted"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "The registry has no chip for that pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotChipped"
                }
              }
            }
          },
          "503": {
            "description": "One of:\n\n- `registry_down`: The chip registry could not be reached; try again\n- `not_recorded`: The adoption could not be recorded; try again",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RegistryDown"
                    },
                    {
                      "$ref": "#/components/schemas/NotRecorded"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "registry_down": "#/components/schemas/RegistryDown",
                      "not_recorded": "#/components/schemas/NotRecorded"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "enum": [
              "Cat",
              "Dog",
              "Parrot",
              "Tortoise"
            ]
          },
          "adopted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "species",
          "adopted"
        ]
      },
      "NoSuchPet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "message"
        ]
      },
      "AlreadyAdopted": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "already_adopted"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "message"
        ],
        "description": "That pet has already been adopted"
      },
      "BeingAdopted": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "being_adopted"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "message"
        ],
        "description": "That pet is being adopted; it may come back to the shelf"
      },
      "NotChipped": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "message"
        ]
      },
      "RegistryDown": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "registry_down"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "message"
        ],
        "description": "The chip registry could not be reached; try again"
      },
      "NotRecorded": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "not_recorded"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "message"
        ],
        "description": "The adoption could not be recorded; try again"
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}

<!-- Tests log at WARN and above. In test fixtures so the load test gets it too. -->
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Kafka's clients warn about every topic they create on first use. -->
    <logger name="org.apache.kafka" level="ERROR"/>

    <!-- At INFO for LoggingSpec's appender, but not printed: the tests provoke refusals on purpose. -->
    <logger name="petshop" level="INFO" additivity="false"/>
    <logger name="lark" level="INFO" additivity="false"/>

    <root level="WARN">
        <appender-ref ref="console"/>
    </root>
</configuration>

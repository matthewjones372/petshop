{
  "allowManagedHooksOnly": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v gauntlet >/dev/null 2>&1; then exec gauntlet hook stop; fi; echo \"Gauntlet isn't installed on this machine, so this work wasn't checked. Install it with: curl -fsSL https://raw.githubusercontent.com/matthewjones372/gauntlet/main/install.sh | sh\" >&2; exit 1",
            "statusMessage": "Gauntlet is checking the change (build, tests, coverage)…",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gauntlet >/dev/null 2>&1 || exit 0; exec gauntlet hook pre-tool-use"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v gauntlet >/dev/null 2>&1; then exec gauntlet hook stop; fi; echo \"Gauntlet isn't installed on this machine, so this work wasn't checked. Install it with: curl -fsSL https://raw.githubusercontent.com/matthewjones372/gauntlet/main/install.sh | sh\" >&2; exit 1",
            "statusMessage": "Gauntlet is checking the subagent's change (build, tests, coverage)…",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(**/*.gradle.kts)",
      "Write(**/*.gradle.kts)",
      "MultiEdit(**/*.gradle.kts)",
      "NotebookEdit(**/*.gradle.kts)",
      "Edit(**/junit-platform.properties)",
      "Write(**/junit-platform.properties)",
      "MultiEdit(**/junit-platform.properties)",
      "NotebookEdit(**/junit-platform.properties)",
      "Edit(**/src/test/resources/**)",
      "Write(**/src/test/resources/**)",
      "MultiEdit(**/src/test/resources/**)",
      "NotebookEdit(**/src/test/resources/**)",
      "Edit(**/src/test/resources/junit-platform.properties)",
      "Write(**/src/test/resources/junit-platform.properties)",
      "MultiEdit(**/src/test/resources/junit-platform.properties)",
      "NotebookEdit(**/src/test/resources/junit-platform.properties)",
      "Edit(**/src/testFixtures/**)",
      "Write(**/src/testFixtures/**)",
      "MultiEdit(**/src/testFixtures/**)",
      "NotebookEdit(**/src/testFixtures/**)",
      "Edit(*.gradle.kts)",

{
  "mappings": [
    {
      "name": "a new keeper is recorded as asked",
      "request": {
        "method": "POST",
        "urlPathPattern": "/chips/[0-9]+/keeper"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "number": "{{request.path.[1]}}",
          "keeper": "{{jsonPath request.body '$.keeper'}}"
        },
        "transformers": [
          "response-template"
        ]
      }
    }
  ]
}

{
  "mappings": [
    {
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPathPattern": "/chips/[^/]+"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"number\":\"98100000000{{request.pathSegments.[1]}}\",\"keeper\":\"Petshop\"}",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/chips/3"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"message\":\"The registry has no chip under that id\"}"
      }
    }
  ]
}

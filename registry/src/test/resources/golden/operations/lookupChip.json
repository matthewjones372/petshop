{
  "paths": {
    "/chips/{petId}": {
      "get": {
        "summary": "The chip a pet was registered with",
        "operationId": "lookupChip",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "The id the shop registered the pet under",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChipRecord"
                }
              }
            }
          },
          "404": {
            "description": "The registry has no chip under that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChipRecord": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "keeper": {
            "type": "string"
          }
        },
        "required": [
          "keeper",
          "number"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}

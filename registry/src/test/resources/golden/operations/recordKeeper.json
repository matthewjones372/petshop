{
  "paths": {
    "/chips/{chipNumber}/keeper": {
      "post": {
        "summary": "Record who keeps the pet the chip is in",
        "operationId": "recordKeeper",
        "parameters": [
          {
            "name": "chipNumber",
            "in": "path",
            "required": true,
            "description": "The number printed on the chip",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Who keeps the pet from now on",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewKeeper"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChipRecord"
                }
              }
            }
          },
          "404": {
            "description": "The registry has no chip under that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewKeeper": {
        "type": "object",
        "properties": {
          "keeper": {
            "type": "string"
          }
        },
        "required": [
          "keeper"
        ]
      },
      "ChipRecord": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "keeper": {
            "type": "string"
          }
        },
        "required": [
          "keeper",
          "number"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}
